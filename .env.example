# Read by docker-compose.yml (Compose auto-loads a repo-root .env for
# ${VAR} substitution) — NOT read by any of the three services directly;
# each of those has its own .env.example (gateway/, ml-backend/,
# frontend/.env.local) for running outside Docker.
#
# These specifically back the frontend image's build ARGs (see
# frontend/Dockerfile) — Vite bakes VITE_* vars into the built JS at
# build time, so docker-compose.yml has to pass them as build args, which
# in turn have to come from somewhere Compose can read before the build
# even starts. Copy this to a real `.env` (gitignored, same as every other
# .env in this repo) and fill in real values before `docker compose build`.

# Host-reachable gateway URL — the frontend bundle runs in the browser,
# outside the Docker network, so this must NOT be the gateway's compose
# service name. Matches docker-compose.yml's gateway port mapping.
VITE_GATEWAY_URL=http://localhost:5000/api

# Firebase web app config, per docs/architecture/adr/ADR-0005-firebase-auth-migration.md.
# Get these from: Firebase Console -> Project Settings -> Your apps -> Web app.
# Not secrets the way JWT_SECRET/INTERNAL_API_KEY are (see frontend/.env.example) —
# still not committed here for real values, to keep this file a template.
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
VITE_FIREBASE_APP_ID=your_firebase_app_id_here
