# Generate a real value with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-with-your-own-generated-secret

# Only set this to True for local development. Leaving it True in any real
# deployment is a genuine risk — an unhandled exception returns Django's
# full debug page (traceback, local variables, and often settings values),
# and the gateway now refuses to forward anything that isn't its own known
# error shape, but the safest fix is simply never running with DEBUG=True
# outside local dev in the first place.
DEBUG=False

ALLOWED_HOSTS=127.0.0.1,localhost
PUBMED_TOOL_NAME=AMR-Insight
PUBMED_CONTACT_EMAIL=your-real-email@example.com
PUBMED_API_KEY=your-key-here
GEMINI_API_KEY=your-key-here
INTERNAL_API_KEY=replace-with-a-generated-shared-secret